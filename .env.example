FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
INBOX_HELPER_WORKER_MODEL=gpt-5.6-luna
INBOX_HELPER_CRITIC_MODEL=gpt-5.5
# Used only by the evaluation commands. Pick a model from a different vendor.
INBOX_HELPER_JUDGE_MODEL=Mistral-Large-3
# The hosted agent's name on Foundry, and the guardrail policy to attach when deploying.
INBOX_HELPER_AGENT_NAME=inbox-helper
INBOX_HELPER_RAI_POLICY_ID=/subscriptions/<subscription>/resourceGroups/<group>/providers/Microsoft.CognitiveServices/accounts/<resource>/raiPolicies/Microsoft.DefaultV2
# The grader for Foundry's cloud evaluation (evals/cloud_eval.py). Not the critic's model.
INBOX_HELPER_GRADER_MODEL=gpt-6-sol
